---
import I18nText from './I18nText.astro';

interface Props { active?: string }
const { active = '' } = Astro.props;
const items = [
  { key: 'philosophy', href: '/philosophy/', markZh: '壱', markEn: 'I', zh: '壱·哲学', en: 'I · Phil.' },
  { key: 'cognition', href: '/cognition/', markZh: '弐', markEn: 'II', zh: '弐·认知', en: 'II · Cog.' },
  { key: 'reality', href: '/reality-lens/', markZh: '叁', markEn: 'III', zh: '叁·透镜', en: 'III · Lens' },
  { key: 'atlas', href: '/atlas/', markZh: '肆', markEn: 'IV', zh: '肆·图谱', en: 'IV · Atlas' },
] as const;
---
<nav class="mobile-bottom-nav" aria-label="Mobile navigation">
  {items.map((it) => (
    <a href={it.href} aria-current={active === it.key ? 'page' : undefined}>
      <span class="nav-mark"><I18nText zh={it.markZh} en={it.markEn} /></span>
      <I18nText zh={it.zh} en={it.en} />
    </a>
  ))}
</nav>
