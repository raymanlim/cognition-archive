---
import I18nText from './I18nText.astro';
import I18nBlock from './I18nBlock.astro';
import type { CrossLink, CrossMatrix } from '../data/types';

interface Props { matrix: CrossMatrix; inDrawer?: boolean }
const { matrix, inDrawer = false } = Astro.props;

const layers = [
  { key: 'philosophers', k: 'layerPhilosophers' as const, links: matrix.philosophers, color: 'var(--cinnabar)' },
  { key: 'cpv', k: 'layerCpv' as const, links: matrix.cpv, color: 'var(--pine)' },
  { key: 'cognition', k: 'layerCognition' as const, links: matrix.cognition, color: 'var(--obi)' },
  { key: 'models', k: 'layerModels' as const, links: matrix.models, color: 'var(--cinnabar)' },
];
---
<div class:list={['leaf-card', 'p-4 sm:p-5', { 'mt-4': inDrawer }]} style="border-color:var(--rule-strong)">
  <div class="flex items-center justify-between gap-2 pb-3 mb-4 border-b" style="border-color:var(--rule)">
    <div class="eyebrow"><I18nText k="marginaliaLabel" /></div>
    <span class="text-[.68rem] font-sans" style="color:var(--ink-faint)">{matrix.cardId}</span>
  </div>

  <p class="text-[.8rem] leading-relaxed mb-4" style="color:var(--ink-faint)"><I18nText k="marginaliaHint" /></p>

  <div class="space-y-4">
    {layers.map((layer) => (
      <section>
        <div class="flex items-center gap-2 mb-2">
          <span class="rule-dot" style={`background:${layer.color}`}></span>
          <span class="text-[.76rem] font-bold tracking-wide"><I18nText k={layer.k} /></span>
          <span class="text-[.68rem] font-sans" style="color:var(--ink-faint)">{layer.links.length}</span>
        </div>
        {layer.links.length > 0 ? (
          <ul class="space-y-1.5">
            {layer.links.map((l: CrossLink) => (
              <li>
                <a href={l.href}
                   class="block text-[.82rem] leading-snug px-2.5 py-2 border-l-2 hover:translate-x-0.5 transition-transform"
                   style="border-color:var(--rule-strong);background:var(--card-2)"
                   title={l.labelEn}>
                  <I18nBlock zh={l.label} en={l.labelEn} />
                  {l.reason.startsWith('Auto-matched') && <span class="ml-1 text-[.62rem]" style="color:var(--pine)">AUTO</span>}
                </a>
              </li>
            ))}
          </ul>
        ) : <span class="text-[.75rem]" style="color:var(--ink-faint)">—</span>}
      </section>
    ))}
  </div>

  {matrix.axioms.length > 0 && (
    <section class="pt-4 mt-4 border-t" style="border-color:var(--rule)">
      <div class="eyebrow mb-2"><I18nText k="layerAxioms" /></div>
      <div class="flex flex-wrap gap-1.5">
        {matrix.axioms.map((a) => (
          <a href={`/atlas#axiom-${a.key}`} class="badge hover:border-cinnabar">
            <I18nText zh={a.name} en={a.nameEn} />
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="pt-4 mt-4 border-t collapsible" style="border-color:var(--rule)" data-collapsible data-open="false">
    <button type="button" class="collapsible-toggle flex items-center justify-between w-full text-[.78rem] font-bold" data-collapsible-toggle>
      <span><I18nText k="selfCheck" /> · 7 + 5</span>
      <span class="chev" style="color:var(--cinnabar)">›</span>
    </button>
    <div class="collapsible-body pt-3 space-y-4">
      <div>
        <div class="text-[.74rem] font-bold mb-1.5" style="color:var(--pine)"><I18nText k="checklistPre" /></div>
        <ol class="space-y-1.5">
          {matrix.preQuestions.map((q, i) => (
            <li class="flex gap-2 text-[.78rem] leading-snug">
              <span class="shrink-0 font-sans" style="color:var(--cinnabar)">{i + 1}.</span>
              <I18nBlock t={q} />
            </li>
          ))}
        </ol>
      </div>
      <div>
        <div class="text-[.74rem] font-bold mb-1.5" style="color:var(--pine)"><I18nText k="checklistPost" /></div>
        <ol class="space-y-1.5">
          {matrix.postQuestions.map((q, i) => (
            <li class="flex gap-2 text-[.78rem] leading-snug">
              <span class="shrink-0 font-sans" style="color:var(--cinnabar)">{i + 1}.</span>
              <I18nBlock t={q} />
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</div>
