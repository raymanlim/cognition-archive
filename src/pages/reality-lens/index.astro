---
import BaseLayout from '../../layouts/BaseLayout.astro';
import I18nText from '../../components/I18nText.astro';
import I18nBlock from '../../components/I18nBlock.astro';
import CognitiveCard from '../../components/CognitiveCard.astro';
import MarginaliaNote from '../../components/MarginaliaNote.astro';
import { realityCards } from '../../data/reality-lens';
import { curatorNotes } from '../../data/curatorNotes';
import { dict } from '../../data/uiDictionary';
import { axiomTopics, buildCrossLibraryMatrix } from '../../utils/cognitiveEngine';
import { lensCardAnchor, lensItemAnchor } from '../../utils/anchors';

const authorFilters = Object.entries(dict.lensAuthorFilters);
const topicFilters = axiomTopics;
---
<BaseLayout title="现实透镜 / Reality Lens" active="reality"
  description="25 张现实拆解卡片，按作者与 8 个反复回到的主题筛选；每张卡另有可回查的线索和一句策展人备注。">

  <section class="archive-shell page-head">
    <div class="eyebrow mb-3">DIVISION III</div>
    <I18nBlock as="div" class="display-title" zh="现实透镜" en="Reality Lens" />
    <I18nBlock as="div" class="mt-4 body-text text-[.95rem] max-w-3xl"
      zh="25 张现实拆解卡片 · 三层阅读线索 · 8 个我反复回到的主题"
      en="25 reality cards · three layers of reading clues · eight themes I keep returning to" />
  </section>

  <!-- Filters -->
  <section class="archive-shell pt-8 space-y-4 no-print">
    <div class="flex flex-wrap items-center gap-2">
      <span class="eyebrow w-28 shrink-0"><I18nText k="filterAuthor" /></span>
      {authorFilters.map(([key, label]) => (
        <button type="button" class="chip" data-filter-group="author" data-filter-value={key}
                aria-pressed={key === 'all' ? 'true' : 'false'}>
          <I18nText t={label} />
        </button>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="eyebrow w-28 shrink-0"><I18nText k="filterTopic" /></span>
      <button type="button" class="chip" data-filter-group="topic" data-filter-value="all" aria-pressed="true">
        <I18nText k="filterAllTopics" />
      </button>
      {topicFilters.map((a) => (
        <button type="button" class="chip" data-filter-group="topic" data-filter-value={a.key} aria-pressed="false">
          <I18nText zh={a.zh} en={a.en} />
        </button>
      ))}
    </div>
    <div class="flex items-center justify-between pt-2 border-b pb-3" style="border-color:var(--rule)">
      <span class="text-[.8rem]" style="color:var(--ink-faint)">
        <span data-filter-count>25</span> / 25 <I18nText k="resultCount" />
      </span>
      <span class="text-[.76rem]" style="color:var(--ink-faint)"><I18nText k="marginaliaHint" /></span>
    </div>
  </section>

  <!-- Cards: 65% main / 35% marginalia, collapsing to an inline drawer on mobile -->
  <section class="archive-shell py-8" data-filter-scope>
    <div class="space-y-9">
      {realityCards.map((c) => {
        const matrix = buildCrossLibraryMatrix(c.id);
        const note = curatorNotes[c.id];
        return (
          <div data-filter-item data-tags={`${c.group} ${c.topics.join(' ')}`} id={lensItemAnchor(c.num)}>
            <div class="split-layout">
              <div class="min-w-0">
                <CognitiveCard
                  card={c}
                  anchor={lensCardAnchor(c.num)}
                  numeral={String(c.num).padStart(2, '0')}
                  extraTags={c.group}
                  asFilterItem={false}
                >
                  <div slot="extra" class="leaf-card p-4 mt-2" style="border-left:3px solid var(--pine)">
                    <div class="field-label mb-2"><I18nText k="curatorNoteLabel" /></div>
                    <I18nBlock as="div" class="body-text text-[.88rem] leading-[1.85]" t={note} />
                  </div>
                  <div slot="extra" class="marginalia-drawer collapsible" data-collapsible data-open="false">
                    <button type="button" class="collapsible-toggle w-full flex items-center justify-between gap-2 px-3 py-2.5 text-[.82rem] font-bold"
                            style="background:var(--card-2);border:1px solid var(--cinnabar);color:var(--cinnabar)"
                            data-collapsible-toggle>
                      <span><I18nText k="openMarginalia" /> · {matrix.cardId}</span>
                      <span class="chev">›</span>
                    </button>
                    <div class="collapsible-body">
                      <MarginaliaNote matrix={matrix} inDrawer={true} />
                    </div>
                  </div>
                </CognitiveCard>
              </div>

              <aside class="marginalia no-print">
                <div class="border-l-2 pl-4" style="border-color:var(--cinnabar)">
                  <MarginaliaNote matrix={matrix} />
                </div>
              </aside>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="archive-shell pb-4">
    <I18nBlock as="p" class="source-note text-[.8rem]"
      zh="眉批里的线索来自人工映射与关键词补全，点击可跳回原文所在版块；策展人备注则是另加的一层，不替作者下结论，也不改动原有挂载。"
      en="The marginalia clues come from curated mappings and keyword augmentation; click to return to the relevant section. Curator’s notes are a separate layer: they do not speak for the source author or alter the original mounting." />
  </section>
</BaseLayout>
